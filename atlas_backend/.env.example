# ATLAS backend configuration. Copy to .env and fill in. Never commit .env.

# --- Data source (which adapter connects ATLAS to the habitat) ------------

# grafana   reach the habitat's InfluxDB through Grafana's datasource proxy.
# influxdb  talk to InfluxDB 1.x directly over its HTTP query API.
# sqlite    read a local SQLite file (also the offline demo habitat).
#
# Adding another backend is a new adapter class in app/datasource/ plus a line
# in its ADAPTERS map — the core telemetry logic never changes.
DATA_SOURCE=grafana

# --- Grafana adapter (DATA_SOURCE=grafana) ---------------------------------

# Base URL of the habitat Grafana. No trailing slash.
GRAFANA_URL=

# Authenticate with EITHER a token OR user/pass. Token wins if both are set.
GRAFANA_TOKEN=
GRAFANA_USER=
GRAFANA_PASS=

# The InfluxDB datasource to query, by uid. Run
# `python scripts/discover_datasources.py` if this is wrong.
GRAFANA_DATASOURCE_UID=

# --- Direct InfluxDB adapter (DATA_SOURCE=influxdb) ------------------------

# Only needed when DATA_SOURCE=influxdb. Base URL of InfluxDB, no trailing slash.
INFLUX_URL=
# Authenticate with EITHER a token (InfluxDB 1.8+) OR user/pass. Token wins.
INFLUX_TOKEN=
INFLUX_USER=
INFLUX_PASS=

# The InfluxDB database name. Required for the direct adapter. For the Grafana
# adapter it is optional — normally discovered from the datasource definition;
# set it only if that discovery fails.
INFLUX_DB=

# Seconds to wait on a habitat-database HTTP call.
DATASOURCE_TIMEOUT=20

# --- Direct SQLite adapter (DATA_SOURCE=sqlite) ----------------------------

# Path to a SQLite file in ATLAS's canonical readings schema. Relative paths
# resolve against the backend directory. Build the shipped offline demo with
# `python scripts/seed_demo_sqlite.py`, then set:
#   DATA_SOURCE=sqlite
#   SQLITE_PATH=config/examples/demo_habitat.db
#   HABITAT_CONFIG=config/examples/demo_habitat.yaml
SQLITE_PATH=

# --- SQL adapter (DATA_SOURCE=sql) -----------------------------------------

# Map ATLAS onto an EXISTING relational database — Postgres, MySQL, Timescale.
# The table/column mapping lives in the habitat profile's `sql_mapping:` section
# (see config/examples/postgres_habitat.yaml). Install the driver you need:
#   PostgreSQL/Timescale:  pip install 'psycopg[binary]'  (or psycopg2-binary)
#   MySQL/MariaDB:         pip install pymysql
# A DB-API DSN:
#   postgresql://user:pass@host:5432/habitat
#   mysql://user:pass@host:3306/habitat
#   sqlite:///relative/path.db   (also how the SQL adapter is unit-tested)
SQL_DSN=

# --- Habitat profile (the sensors, zones and units of THIS habitat) --------

# Path to a habitat profile (YAML) holding everything mission-specific: the
# habitat's display name, its rooms, sensor units, tanks/stocks, mission meters
# and dashboard panels. A relative path resolves against the backend directory.
#
# THERE IS NO DEFAULT HABITAT. Leaving this blank runs with no profile: units
# read as "not recorded" and the dashboard is derived from whatever the database
# holds. Set it. Copy an example to make your own:
#   mkdir -p config/private
#   cp config/examples/habitat.example.yaml config/private/my_habitat.yaml
#   HABITAT_CONFIG=config/private/my_habitat.yaml
#
# Shipped examples:
#   config/examples/habitat.example.yaml   every option, documented
#   config/examples/demo_habitat.yaml      the offline SQLite demo
#   config/examples/postgres_habitat.yaml  a SQL-mapped habitat template
HABITAT_CONFIG=config/examples/demo_habitat.yaml

# --- Knowledge base (Settings > Connectors) --------------------------------

# Documents the assistant may read: procedures, emergency numbers, checklists.
# Uploaded through the interface, stored here, and indexed on this machine.
KNOWLEDGE_DIR=knowledge

# The LOCAL model used to embed passages. Everything stays on this machine and
# costs nothing; there is no API involved. Install it once:
#   ollama pull nomic-embed-text
# Without it the knowledge base still works, matching on shared words instead of
# meaning, and the Connectors page says so.
EMBEDDING_MODEL=nomic-embed-text

# Largest document accepted, in megabytes.
MAX_UPLOAD_MB=25

# How many passages are handed to the model for one question.
KNOWLEDGE_RESULTS=6

# --- Optional local voice (microphone and spoken answers) -----------------

# Voice never calls a hosted speech API. Install whisper.cpp, ffmpeg, and
# Piper locally, then point ATLAS at model files you downloaded and licensed.
# Relative model paths resolve from atlas_backend/. Leave either model blank to
# disable that half of the voice interface.
VOICE_WHISPER_CLI=whisper-cli
VOICE_WHISPER_MODEL=models/ggml-tiny.bin
VOICE_WHISPER_LANGUAGE=auto
VOICE_WHISPER_THREADS=4
VOICE_FFMPEG_CLI=ffmpeg
VOICE_PIPER_CLI=piper
VOICE_PIPER_MODEL=models/en_US-lessac-medium.onnx
VOICE_MAX_UPLOAD_MB=12
VOICE_TIMEOUT=180

# --- Which model answers ---------------------------------------------------

# ollama    the model runs on this machine. No API calls, nothing leaves it.
# anthropic Claude, in the cloud.
#
# This is only the default. Whatever was last chosen on the Models page is
# stored in the database and wins over it.
LLM_PROVIDER=ollama

# --- Ollama (the local runtime) --------------------------------------------

# Install Ollama first: https://ollama.com/download — then `ollama serve`, or
# just open the app. Models are installed from the Models page in the
# interface; nothing needs pulling by hand.
OLLAMA_HOST=http://127.0.0.1:11434

# The model to use until one is chosen in the interface. It must support tool
# calling — ATLAS answers by querying InfluxDB, and a model that cannot call
# a tool cannot query anything.
OLLAMA_MODEL=qwen3:8b

# Context window in tokens. The system prompt (~3,400 tokens) and the fourteen
# tool definitions (~4,500) spend about 7,900 before the question is even read,
# and a declared mission plan adds a few hundred more — so Ollama's own default
# of 4096 cannot run this application at all. Do not go below 12288: the tools
# stop fitting, and a model with no tools answers without reading a sensor.
OLLAMA_NUM_CTX=16384

# On a 16 GB machine, halve the memory the context costs by quantising the
# KV cache. Set these on the OLLAMA SERVER, not here — they are its settings:
#   launchctl setenv OLLAMA_FLASH_ATTENTION 1
#   launchctl setenv OLLAMA_KV_CACHE_TYPE q8_0
# then restart Ollama.

# Cap on one answer. -1 for the model's own limit.
OLLAMA_MAX_TOKENS=4096

# Low on purpose: every number in an answer has to be the one the query
# returned, and this is not a task where invention helps.
OLLAMA_TEMPERATURE=0.2

# How long the weights stay in memory after a question. Reloading 5 GB per
# question is the difference between two seconds and thirty.
OLLAMA_KEEP_ALIVE=30m

# Seconds to wait on one answer. The first question of a session also loads
# the model from disk.
OLLAMA_TIMEOUT=600

# auto | disabled. Auto shows the reasoning of models that have any, and is
# ignored by models that do not.
OLLAMA_THINKING=auto

# Where Ollama keeps the weights, for display on the Models page. Ollama's own
# OLLAMA_MODELS setting is what actually decides this — setting it here
# without setting it there changes nothing. Leave blank to report the default.
OLLAMA_MODELS_DIR=

# --- Anthropic -------------------------------------------------------------

# Only needed if LLM_PROVIDER=anthropic, or if the cloud is selected on the
# Models page. Leave blank to run entirely locally.
ANTHROPIC_API_KEY=

# claude-opus-5 is the current flagship. claude-opus-4-8 also works.
ANTHROPIC_MODEL=claude-opus-5

ANTHROPIC_MAX_TOKENS=8192

# Reasoning depth: low | medium | high | xhigh | max.
# medium suits telemetry lookups; raise it for multi-step analysis.
ANTHROPIC_EFFORT=medium

# adaptive | disabled. Adaptive lets the model decide when to think.
ANTHROPIC_THINKING=adaptive

# --- Things that are NOT configured here -----------------------------------

# Two settings live in the database rather than in this file, because both are
# changed from the interface and have to survive a restart:
#
#   The mission plan  — its start date, its length, the consumption ceiling for
#                       each resource, and the extras. Set it on the Dashboard's
#                       Mission view. A fresh install has none, and ATLAS will
#                       say so rather than compare consumption against a target
#                       nobody set.
#   The answer style  — concise, detailed, unhinged, or your own instructions.
#                       Set it on the Settings page. Defaults to concise.

# --- Agent loop ------------------------------------------------------------

# How many query/answer cycles one question may take before giving up.
MAX_TOOL_ROUNDS=10

# --- HTTP service ----------------------------------------------------------

ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Browser origins allowed to call this API. The Vite dev server is 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chat history (SQLite) -------------------------------------------------

# SQLite file holding saved conversations. A relative path resolves against
# the backend directory, so history survives restarts and working-directory
# changes alike.
DATABASE_PATH=atlas.db

# How many stored messages of a thread are replayed to the model. The whole
# thread stays on disk regardless — this only bounds the context per request.
MAX_TURNS_PER_CONVERSATION=200

# Threads listed in the sidebar, newest first.
MAX_CONVERSATIONS_LISTED=200
