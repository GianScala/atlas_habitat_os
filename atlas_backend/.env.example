# Copy to .env. Setup and advanced options: ../docs/configuration.md
# Keep credentials in .env only; never commit them.

# Demo telemetry: generate the database using the README quick start.
DATA_SOURCE=sqlite
SQLITE_PATH=config/examples/demo_habitat.db
HABITAT_CONFIG=config/examples/demo_habitat.yaml

# Local model (provider: ollama | anthropic).
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional cloud provider.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=your-model-id

# Optional Grafana source (DATA_SOURCE=grafana).
GRAFANA_URL=
GRAFANA_TOKEN=
GRAFANA_USER=
GRAFANA_PASS=
GRAFANA_DATASOURCE_UID=

# Optional InfluxDB 1.x source (DATA_SOURCE=influxdb).
INFLUX_URL=
INFLUX_DB=
INFLUX_TOKEN=
INFLUX_USER=
INFLUX_PASS=

# Optional relational source (DATA_SOURCE=sql).
SQL_DSN=

# Local application data.
DATABASE_PATH=atlas.db
KNOWLEDGE_DIR=knowledge
EMBEDDING_MODEL=nomic-embed-text
MAX_UPLOAD_MB=25

# Optional local voice; download models separately.
VOICE_WHISPER_MODEL=models/ggml-tiny.bin
VOICE_PIPER_MODEL=models/en_US-lessac-medium.onnx

# Local HTTP service; remote access requires an authenticated gateway.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
