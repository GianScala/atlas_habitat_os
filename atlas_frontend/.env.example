# ATLAS frontend configuration. Copy to .env.local if you need to override.
# Everything here is optional — the defaults work for local development.

# Where the backend lives. Leave unset in development: the Vite dev server
# proxies /api to VITE_API_TARGET, so the browser sees one origin and CORS
# never applies. Set this only when serving the built bundle from a different
# origin than the API.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# What the dev-server proxy forwards /api to. Change if the backend is not on
# the default port.
# VITE_API_TARGET=http://127.0.0.1:8000
