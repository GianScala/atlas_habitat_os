# Repo-wide ignores. Each half also has its own .gitignore for the things
# only it produces (node_modules, .venv, build output).

.DS_Store
*.swp
*~

# Local editor and AI-assistant state, at any depth.
.idea/
.vscode/
.claude/
.codex/
.agents/
.cursor/
.aider*
*.iml

# Environment files are private; only sanitized examples are public.
.env
.env.*
!.env.example

# Private keys and common local credential stores.
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
service-account*.json
secrets.json
secrets.yaml
secrets.yml
.aws/
.ssh/
# Runtime data and exports, regardless of which component creates them.
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.log
*.csv
*.tsv
*.sql
*.dump
*.bak
*.zip
*.tar
*.gz
/private/
/data/
/exports/
/backups/

# Dependencies and generated state, including tools run from the repo root.
node_modules/
dist/
build/
*.egg-info/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.vite/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage/
*.tsbuildinfo

# Local speech runtime session artifacts.
*.ses
